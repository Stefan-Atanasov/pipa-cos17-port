<?xml version="1.0" encoding="utf-8"?>
<!-- pipa helper: port-side glue for ColorOS 17 on the Xiaomi Pad 6.
     Installed as a system app (module system/app or ROM), so persistent="true" is honoured:
     ActivityManager starts it at boot and never kills it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.port.pipa.helper"
    android:versionCode="29"
    android:versionName="2.9">

    <uses-sdk android:minSdkVersion="35" android:targetSdkVersion="37" />

    <!-- creating an AudioEffect on the global output mix -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- pen battery pop-ups (runtime permission; pre-granted in the ROM build) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- pen pill overlay (appop; pre-granted in the ROM build) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- lid_behavior from the "lock with cover" switch (privapp whitelist in the ROM) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Circle to Search (contextual_search service; privapp whitelist in the ROM) -->
    <uses-permission android:name="android.permission.ACCESS_CONTEXTUAL_SEARCH" />
    <!-- foreground game detection: ActivityManager.addOnUidImportanceListener (privapp whitelist in the ROM) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- see other apps' ApplicationInfo (game category) despite Android 11+ package visibility -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- helper 2.5: end a game's background process after a device identity change (normal permission) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- helper 2.5: Effects > Reboot to apply (privapp allowlist in the ROM, step 8h) -->
    <uses-permission android:name="android.permission.REBOOT" />

    <application
        android:name=".HelperApp"
        android:label="@string/app_name"
        android:persistent="true"
        android:directBootAware="true"
        android:hasCode="true"
        android:allowBackup="false">
        <!-- start path when installed as a normal app (testing); a system app starts as persistent -->
        <!-- Quick Settings tile: Quiet/Verbose system logs (pipa_port sets persist.log.tag, 5x) -->
        <service android:name=".LogTile" android:exported="true" android:label="Logs"
            android:icon="@drawable/ic_logs"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- helper 2.8 (8s, BUGS 164): the Live blur Quick Settings tile is gone; the switch is in Effects (7x key pipa_live_blur) -->
        <!-- helper 2.0 assistant (7s): gesture-bar long press -> Circle to Search, corner swipe -> Gemini.
             The system binds it while the helper holds the assistant role; idle otherwise (no hotword). -->
        <service android:name=".AssistService" android:exported="true" android:label="pipa assistant"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data android:name="android.voice_interaction" android:resource="@xml/assist_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service android:name=".AssistSessionService" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name=".NoRecognitionService" android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>
        <!-- helper 2.5: the Pipa Helper app (launcher entry): home, menus (Pen, Keyboard case, Display, Effects, Sound,
             Games, Battery, System), pen buttons with live test. Own process ":ui": the keepers stay safe from UI crashes. -->
        <activity android:name=".MainActivity" android:exported="true" android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_helper" android:process=":ui" android:launchMode="singleTask"
            android:theme="@style/PipaTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PageActivity" android:exported="false" android:process=":ui"
            android:theme="@style/PipaTheme" />
        <activity android:name=".PenSettingsActivity" android:exported="false" android:process=":ui"
            android:theme="@style/PipaTheme" />
        <!-- helper 2.5: pen button actions that need an app API (flashlight); sent by pen_keys.sh (root) -->
        <receiver android:name=".PenActionReceiver" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.port.pipa.helper.TORCH" />
            </intent-filter>
        </receiver>
        <!-- fallback before 2.0 / without the assistant service: ACTION_ASSIST activity (4g) -->
        <activity android:name=".CircleSearchActivity" android:exported="true" android:label="Circle to Search"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true"
            android:noHistory="true" android:launchMode="singleInstance">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver android:name=".BootReceiver" android:exported="false" android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
