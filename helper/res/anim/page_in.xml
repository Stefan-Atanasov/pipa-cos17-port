<?xml version="1.0" encoding="utf-8"?>
<!-- helper 2.5: a page slides in from the right and fades in -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic" android:duration="300">
    <translate android:fromXDelta="12%p" android:toXDelta="0" />
    <alpha android:fromAlpha="0" android:toAlpha="1" />
</set>
