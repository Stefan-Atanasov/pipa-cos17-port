;; pipa port 5i (2026-11-04): SELinux round 2 from a full capture of pt45 (audit rate 2000: boot, heavy_mix,
;; cold starts, shade, apps, screen off/on, idle and a user session). Core domains.
;; Allow: OPPO UI First / frame boost hints, the same set platform_app and priv_app have in the OPPO policy
;; (sched_assist ux_task, ux_task_app with ioctl 0x2700-0x2701, frame_boost ctrl/sys_ctrl, binder ux_flag).
(allow surfaceflinger oplus_scheduler_sched_assist_proc (dir (search getattr)))
(allow surfaceflinger oplus_scheduler_sched_assist_proc (file (read write getattr open)))
(allow surfaceflinger oplus_ux_task_app_proc (file (ioctl read write getattr open)))
(allowx surfaceflinger oplus_ux_task_app_proc (ioctl file ((range 0x2700 0x2701))))
(allow bootanim oplus_scheduler_sched_assist_proc (dir (search getattr)))
(allow bootanim oplus_scheduler_sched_assist_proc (file (read write getattr open)))
(allow bootanim oplus_ux_task_app_proc (file (ioctl read write getattr open)))
(allowx bootanim oplus_ux_task_app_proc (ioctl file ((range 0x2700 0x2701))))
(allow bootanim proc_frame_boost_ctrl (file (ioctl read write getattr open)))
(allowx bootanim proc_frame_boost_ctrl (ioctl file ((range 0xde01 0xde03))))
(allow bootanim proc_frame_boost_sys_ctrl (dir (search)))
(allow bootanim proc_frame_boost_sys_ctrl (file (ioctl read write getattr open)))
(allowx bootanim proc_frame_boost_sys_ctrl (ioctl file ((range 0xde01 0xde03) (range 0xde09 0xde0a))))
(allow bootanim oplus_binder_proc (dir (search getattr)))
(allow bootanim oplus_binder_proc (file (open read write getattr)))
(allow mediaserver oplus_ux_task_app_proc (file (ioctl read write getattr open)))
(allowx mediaserver oplus_ux_task_app_proc (ioctl file ((range 0x2700 0x2701))))
(allow audioserver oplus_ux_task_app_proc (file (ioctl read write getattr open)))
(allowx audioserver oplus_ux_task_app_proc (ioctl file ((range 0x2700 0x2701))))
(allow audioserver proc_frame_boost_ctrl (file (ioctl read write getattr open)))
(allowx audioserver proc_frame_boost_ctrl (ioctl file ((range 0xde01 0xde03))))
(allow audioserver proc_frame_boost_sys_ctrl (dir (search)))
(allow audioserver proc_frame_boost_sys_ctrl (file (ioctl read write getattr open)))
(allowx audioserver proc_frame_boost_sys_ctrl (ioctl file ((range 0xde01 0xde03) (range 0xde09 0xde0a))))
(allow audioserver oplus_binder_proc (dir (search getattr)))
(allow audioserver oplus_binder_proc (file (open read write getattr)))
(allow cameraserver oplus_scheduler_sched_assist_proc (dir (search getattr)))
(allow cameraserver oplus_scheduler_sched_assist_proc (file (read write getattr open)))
(allow cameraserver proc_frame_boost_ctrl (file (ioctl read write getattr open)))
(allowx cameraserver proc_frame_boost_ctrl (ioctl file ((range 0xde01 0xde03))))
(allow cameraserver proc_frame_boost_sys_ctrl (dir (search)))
(allow cameraserver proc_frame_boost_sys_ctrl (file (ioctl read write getattr open)))
(allowx cameraserver proc_frame_boost_sys_ctrl (ioctl file ((range 0xde01 0xde03) (range 0xde09 0xde0a))))
(allow priv_app_36 oplus_ux_task_app_proc (file (ioctl read write getattr open)))
(allowx priv_app_36 oplus_ux_task_app_proc (ioctl file ((range 0x2700 0x2701))))
(allow oplus_backuprestore_app proc_frame_boost_ctrl (file (ioctl read write getattr open)))
(allowx oplus_backuprestore_app proc_frame_boost_ctrl (ioctl file ((range 0xde01 0xde03))))
(allow pipa_port oplus_binder_proc (dir (search getattr)))
(allow pipa_port oplus_binder_proc (file (open read write getattr)))
;; Allow: OPPO game service (oiface) and atlas read GPU clocks and frequencies (game mode); GPU service lookup.
(allow oiface vendor_sysfs_kgsl (dir (search getattr)))
(allow oiface vendor_sysfs_kgsl (lnk_file (read getattr)))
(allow oiface vendor_sysfs_kgsl (file (read getattr open)))
(allow oiface vendor_sysfs_kgsl_gpuclk (file (read getattr open)))
(allow atlasservice vendor_sysfs_kgsl (file (read getattr open)))
(allow oplus_instant_local_service gpu_service (service_manager (find)))
(allow mediaserver game_service (service_manager (find)))
;; Allow: read-only props and small reads (camera, media, Dolby app, SystemUI LE audio, phone, stats daemons).
(allow cameraserver vendor_display_prop (file (read getattr map open)))
(allow mediaserver vendor_default_prop (file (read getattr map open)))
(allow mediaserver vendor_display_prop (file (read getattr map open)))
(allow bootanim vendor_display_prop (file (read getattr map open)))
(allow priv_app_36 vendor_audio_prop (file (read getattr map open)))
(allow priv_app_36 vendor_radio_prop (file (read getattr map open)))
(allow platform_app bluetooth_lea_prop (file (read getattr map open)))
(allow radio bluetooth_prop (file (read getattr map open)))
(allow platform_app_36 incremental_prop (file (read getattr map open)))
(allow ostatsd vendor_bluetooth_prop (file (read getattr map open)))
(allow ostatsd oppo_fingerprint_prop (file (read getattr map open)))
(allow priv_app proc_filesystems (file (read getattr open)))
(allow priv_app_36 proc_filesystems (file (read getattr open)))
(allow platform_app_36 proc_filesystems (file (read getattr open)))
(allow priv_app cgroup (dir (search getattr)))
(allow priv_app cgroup_v2 (dir (search getattr)))
(allow priv_app_36 cgroup (dir (search getattr)))
(allow priv_app_36 cgroup_v2 (dir (search getattr)))
(allow traced_perf proc_meminfo (file (getattr)))
(allow stats proc_meminfo (file (getattr)))
(allow ostatsd proc_meminfo (file (getattr)))
(allow system_app sysfs_net (dir (search getattr)))
;; Silence only (no access).
(dontaudit cameraserver property_socket (sock_file (write)))
(dontaudit cameraserver vendor_perf_service (service_manager (find)))
(dontaudit system_app storage_config_prop (file (read)))
(dontaudit priv_app_36 property_socket (sock_file (write)))
(dontaudit isolated_app content_capture_service (service_manager (find)))
(dontaudit platform_app mnt_user_file (dir (setattr)))
(dontaudit platform_app_36 mnt_user_file (dir (setattr)))
(dontaudit system_server log_tag_prop (property_service (set)))
(dontaudit radio log_tag_prop (property_service (set)))
(dontaudit system_app radio_prop (property_service (set)))
(dontaudit system_server proc (file (read)))
(dontaudit init proc (file (setattr)))
(dontaudit servicemanager usbd (binder (call)))
(dontaudit radio vendor_cnd (binder (call)))
(dontaudit oplus_dump_netcfg netd_service (service_manager (find)))
(dontaudit prng_seeder tmpfs (chr_file (write)))
(dontaudit oplusbootstats rootfs (dir (read)))
(dontaudit oplus_system_debug self (capability (dac_override)))
(dontaudit minidumpreader block_device (blk_file (read write)))
(dontaudit linkerconfig self (capability (kill)))
(dontaudit vdc self (capability (kill)))
(dontaudit fsck self (capability (kill)))
(dontaudit zygote untrusted_app_all (process (ptrace)))
(dontaudit init vendor_sys_qti_display_exec (file (getattr)))
(dontaudit init sysfs_thermal (file (setattr)))
(dontaudit init oppo_reserve_file (dir (mounton)))
(dontaudit init adsprpcd_file (file (mounton)))
(dontaudit debuglog sysfs (file (write)))
(dontaudit init su (process (transition)))
;; nandswap: df over all mounts, meminfo, vendor props (silenced, not allowed: BUGS 70 swap A/B first).
(dontaudit nandswap file_type (dir (getattr)))
(dontaudit nandswap fs_type (filesystem (getattr)))
(dontaudit nandswap proc_meminfo (file (getattr)))
(dontaudit nandswap vendor_default_prop (file (read)))
;; Third-party apps: probes of kernel, battery, zram, net and props (most from FK Kernel Manager). No access.
(dontaudit untrusted_app_all vendor_sysfs_battery_supply (dir (search)))
(dontaudit untrusted_app_all shell_test_data_file (dir (search)))
(dontaudit untrusted_app_all bluetooth_prop (file (read)))
(dontaudit untrusted_app_all proc_pid_max (file (read)))
(dontaudit untrusted_app_all media_rw_data_file (file (relabelfrom)))
(dontaudit untrusted_app_all sysfs_zram (dir (search)))
(dontaudit untrusted_app_all oplus_appchannel_file (dir (read)))
(dontaudit untrusted_app_all self (netlink_route_socket (bind)))
(dontaudit untrusted_app_all proc_net (file (read)))
(dontaudit untrusted_app_all cache_file (lnk_file (read)))
(dontaudit untrusted_app_all window_service (service_manager (find)))
(dontaudit untrusted_app_all qemu_hw_prop (file (read)))
(dontaudit untrusted_app_all proc_version (file (read)))
(dontaudit untrusted_app_all sysfs_net (dir (search)))
(dontaudit untrusted_app_all oem_unlock_prop (file (read)))
(dontaudit untrusted_app_all input_device (dir (search)))
(dontaudit untrusted_app_all selinuxfs (file (read)))
(dontaudit untrusted_app_all proc_filesystems (file (read)))
(dontaudit untrusted_app_all incremental_prop (file (read)))
(dontaudit untrusted_app_all vendor_sysfs_kgsl (file (read)))
