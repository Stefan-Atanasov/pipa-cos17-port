;; pipa port 5k (2026-11-04): last 3 items from the pt47 advanced capture (camera, screen record, split screen,
;; floating window, YouTube, Wi-Fi/Bluetooth/airplane/dark mode/rotation/location/battery saver toggles).
(allow oplus_backuprestore_app proc_frame_boost_sys_ctrl (dir (search)))
(allow oplus_backuprestore_app proc_frame_boost_sys_ctrl (file (ioctl read write getattr open)))
(allowx oplus_backuprestore_app proc_frame_boost_sys_ctrl (ioctl file ((range 0xde01 0xde03) (range 0xde09 0xde0a))))
;; OPPO media list service scans /proc of all processes (here: adb shell processes). No access.
(dontaudit mmlistservice domain (dir (search)))
