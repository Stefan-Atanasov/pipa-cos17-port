; pipa port 9d (BUGS 193): pipa_port runs update_engine_client for the helper's "Install update" (A/B OTA payload)
(allow pipa_port update_engine_service (service_manager (find)))
(allow pipa_port update_engine (binder (call transfer)))
(allow pipa_port update_engine (fd (use)))
(allow update_engine pipa_port (binder (call transfer)))
(allow update_engine pipa_port (fd (use)))
; dual-boot guard: read the header of the target boot partition before an install (read only)
(allow pipa_port block_device (dir (search getattr)))
(allow pipa_port block_device (lnk_file (read getattr)))
(allow pipa_port boot_block_device (blk_file (open read getattr)))
