;; pipa port 3f (BUGS-TODO 12): pipa_port is enforcing. Rules from a permissive boot with persist.logd.audit.rate=2000
;; (maintainer/sepolicy/avc_to_rules.py, 2026-10-28), then tested live with ksud 'enforce pipa_port': no denials.
;; app processes have MLS categories: their /proc/<pid> needs mlstrustedsubject
(typeattributeset mlstrustedsubject (pipa_port))
;; /proc/<pid> of all processes (pgrep, pidof)
(allow pipa_port domain (dir (getattr open read search)))
(allow pipa_port domain (file (getattr open read)))
(allow pipa_port domain (lnk_file (getattr read)))
;; collected denials
(allow pipa_port activity_service (service_manager (find)))
(allow pipa_port apex_art_data_file (dir (search)))
(allow pipa_port apex_art_data_file (file (getattr open read map execute)))
;; 3o: framework.jar is patched, so odrefresh puts the framework boot image into apexdata; the Java tools
;; (settings, input) execute it there. They also log to statsd: not needed, keep it quiet.
(dontaudit pipa_port statsdw_socket (sock_file (write)))
(allow pipa_port apex_info_file (file (getattr open read)))
(allow pipa_port apex_module_data_file (dir (search)))
(allow pipa_port appops_service (service_manager (find)))
(allow pipa_port block_device (dir (open read search)))
(allow pipa_port bluetooth_data_file (dir (search)))
(allow pipa_port bluetooth_data_file (file (getattr open read)))
(allow pipa_port boot_status_prop (file (getattr map open read)))
(allow pipa_port build_attestation_prop (file (getattr map open read)))
(allow pipa_port cgroup (dir (create read setattr)))
(allow pipa_port cgroup (file (getattr read setattr)))
(allow pipa_port dalvik_config_prop (file (getattr map open read)))
(allow pipa_port dalvik_dynamic_config_prop (file (getattr map open read)))
(allow pipa_port dalvik_runtime_prop (file (getattr map open read)))
(allow pipa_port dalvikcache_data_file (dir (getattr search)))
(allow pipa_port default_android_service (service_manager (add)))
(allow pipa_port default_prop (file (getattr map open read)))
(allow pipa_port face_vendor_data_file (dir (add_name getattr open read remove_name search setattr write)))
(allow pipa_port face_vendor_data_file (file (append create getattr ioctl open read rename unlink write)))
(allow pipa_port game_service (service_manager (find)))
(allow pipa_port gpu_device (chr_file (ioctl map open read write)))
(allow pipa_port graphics_config_prop (file (getattr map open read)))
(allow pipa_port graphics_config_writable_prop (file (getattr map open read)))
(allow pipa_port hal_face_service (service_manager (add)))
(allow pipa_port hal_radio_default_exec (file (entrypoint)))
(allow pipa_port hal_radio_service (service_manager (add)))
(allow pipa_port init (unix_stream_socket (connectto)))
(allow pipa_port init_service_status_private_prop (file (getattr map open read)))
(allow pipa_port input_device (chr_file (getattr ioctl open read)))
(allow pipa_port input_device (dir (search)))
(allow pipa_port kernel (process (getsched setsched)))
(allow pipa_port odsign_prop (file (getattr map open read)))
(allow pipa_port oplus_absent_service (service_manager (add)))
(allow pipa_port oplus_dex_prop (file (getattr map open read)))
(allow pipa_port oplus_sched_assist_scene_proc (file (open read write)))
(allow pipa_port oplus_scheduler_sched_assist_proc (dir (search)))
(allow pipa_port oplus_scheduler_sched_assist_proc (file (open write)))
(allow pipa_port oplus_translator_prop (file (getattr map open read)))
(allow pipa_port oplus_ux_task_app_proc (file (open read write)))
(allow pipa_port package_service (service_manager (find)))
(allow pipa_port persist_debug_prop (file (getattr map open read)))
(allow pipa_port self (anon_inode (create ioctl)))
(allow pipa_port self (capability (chown dac_override dac_read_search fowner fsetid kill sys_ptrace)))
(allow pipa_port self (qipcrtr_socket (create getattr read write)))
(allow pipa_port postinstall_mnt_dir (dir (getattr)))
(allow pipa_port proc (file (getattr open read)))
(allow pipa_port proc_swaps (file (open read)))
(allow pipa_port property_socket (sock_file (write)))
(allow pipa_port radio_prop (file (getattr map open read)))
(allow pipa_port resourcecache_data_file (dir (search)))
(allow pipa_port resourcecache_data_file (file (getattr)))
(allow pipa_port servicemanager (binder (call transfer)))
(allow pipa_port settings_service (service_manager (find)))
(allow pipa_port shell_data_file (dir (add_name getattr read remove_name search write)))
(allow pipa_port shell_data_file (file (append create getattr ioctl open read unlink write)))
(allow pipa_port shell_exec (file (entrypoint)))
(allow pipa_port shell_test_data_file (dir (getattr read search)))
(allow pipa_port sysfs (file (getattr open read write)))
(allow pipa_port system_app (binder (call)))
(allow pipa_port system_data_file (dir (add_name getattr remove_name setattr write)))
(allow pipa_port system_data_file (fifo_file (create getattr open read unlink write)))
(allow pipa_port system_data_file (file (create execute execute_no_trans getattr map open read setattr unlink write)))
(allow pipa_port system_data_root_file (dir (read)))
(allow pipa_port system_file (file (execute execute_no_trans getattr map open read)))
(allow pipa_port system_oplus_tango_prop (file (getattr map open read)))
(allow pipa_port system_prop (file (getattr map open read)))
(allow pipa_port system_server (binder (transfer)))
(allow pipa_port tmpfs (file (execute map read write)))
(allow pipa_port vendor_diag_device (chr_file (ioctl open read write)))
(allow pipa_port vendor_radio_prop (file (getattr map open read)))
(allow pipa_port vendor_sysfs_battery_supply (dir (search)))
(allow pipa_port vendor_sysfs_battery_supply (file (open read)))
(allow pipa_port vendor_sysfs_graphics (dir (search)))
(allow pipa_port vendor_sysfs_graphics (file (open read)))
(allow pipa_port vendor_sysfs_usb_supply (dir (search)))
(allow pipa_port vendor_sysfs_usb_supply (file (getattr open read)))
(allow pipa_port xiaomi_touch_device (chr_file (ioctl open read write)))
(allow pipa_port zygote_config_prop (file (getattr map open read)))
(allow pipa_port zygote_exec (file (execute execute_no_trans getattr map open read)))
;; not in the capture: init checks property sets in user space and logs nothing for a permissive domain (3f found
;; ctl.stop denied); one-time paths of early.sh (package cache, idmap) and service.sh (face HAL copy to /data)
(allow pipa_port ctl_start_prop (property_service (set)))
(allow pipa_port ctl_stop_prop (property_service (set)))
(allow pipa_port ctl_restart_prop (property_service (set)))
(allow pipa_port ctl_default_prop (property_service (set)))
(allow pipa_port vendor_radio_prop (property_service (set)))
(allow pipa_port vendor_default_prop (property_service (set)))
(allow pipa_port vendor_default_prop (file (getattr map open read)))
(allow pipa_port system_prop (property_service (set)))
(allow pipa_port system_data_file (dir (add_name create getattr open read remove_name rename reparent rmdir search setattr write)))
(allow pipa_port system_data_file (file (append create execute execute_no_trans getattr ioctl lock map open read rename setattr unlink write)))
(allow pipa_port system_data_file (lnk_file (create getattr read unlink)))
(allow pipa_port shell_data_file (dir (add_name create getattr open read remove_name rmdir search setattr write)))
(allow pipa_port shell_data_file (file (append create getattr ioctl lock open read rename setattr unlink write)))
(allow pipa_port metadata_file (dir (getattr open read remove_name rmdir search write)))
(allow pipa_port metadata_file (file (getattr unlink)))
(allow pipa_port resourcecache_data_file (dir (add_name getattr open read search write)))
(allow pipa_port resourcecache_data_file (file (create getattr open read setattr write)))
