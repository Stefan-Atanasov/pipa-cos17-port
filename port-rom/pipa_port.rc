# pipa port runtime (beta5-2e): the pieces the ROM cannot do natively yet, formerly the
# pipa_core / power-tune / pipa_port modules. Domain pipa_port: permissive in 2e, enforcing since 3f
# (maintainer/sepolicy/pipa_port_rules.cil; 3g and 3w added rules).
on post-fs-data
    mkdir /data/misc/pipa_port 0770 root root
    exec u:r:pipa_port:s0 root root -- /system/bin/sh /system_ext/pipa_port/early.sh
    # Virtual modem HALs for interconnect (ISubsys/default, ISubsysRadio/slot1+2). The odm copy
    # runs as hal_radio_default, which is denied /dev/diag, and never registers.
    start pipa_subsys0
    start pipa_subsys1
    # B9 network/call/SMS sharing (3c): the OPPO odm sets these, pipa's odm does not. dsds = two virtual SIM
    # slots for the phone's SIMs (with one slot com.android.phone crashes on slot 1 in OplusVmServiceStateOberser).
    # Set before telephony starts, so no SIM-mode reboot. A vendor prop from my_product build.prop is ignored.
    setprop persist.radio.multisim.config dsds
    setprop persist.vendor.radio.virtualcomm 1

on property:sys.boot_completed=1
    start pipa_port

service pipa_subsys0 /odm/bin/hw/subsys_daemon -l /odm/lib64/libqti-radio-service.so -i 0
    user root
    group root
    seclabel u:r:pipa_port:s0
    disabled
    oneshot

service pipa_subsys1 /odm/bin/hw/subsys_daemon -l /odm/lib64/libqti-radio-service.so -i 1
    user root
    group root
    seclabel u:r:pipa_port:s0
    disabled
    oneshot

# face HAL + watchdog, charger shim, pen, colour restore, defaults (service.sh)
service pipa_port /system/bin/sh /system_ext/pipa_port/service.sh
    user root
    group root
    seclabel u:r:pipa_port:s0
    disabled
